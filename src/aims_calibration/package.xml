<?xml version="1.0"?>
<package format="3">
  <name>aims_calibration</name><version>0.1.0</version>
  <description>Selector-controlled, source-time longitudinal vehicle calibration.</description>
  <maintainer email="maintainers@aimsracer.local">AIMSRacer maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vesc_msgs</exec_depend><exec_depend>crsf_receiver_msg</exec_depend>
  <exec_depend>aims_pp</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ackermann_mux</test_depend>
  <test_depend>vesc_driver</test_depend>
  <test_depend>vesc_ackermann</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
