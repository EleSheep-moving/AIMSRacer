<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- The model origin/base_link is the rear axle, matching MPCC's state. -->
  <model name="aims_racer">
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial><mass>3.0</mass><inertia><ixx>0.035</ixx><iyy>0.080</iyy><izz>0.105</izz></inertia></inertial>
      <collision name="chassis_collision"><pose>0.18 0 0.12 0 0 0</pose><geometry><box><size>0.52 0.27 0.12</size></box></geometry></collision>
      <visual name="chassis_visual"><pose>0.18 0 0.12 0 0 0</pose><geometry><box><size>0.52 0.27 0.12</size></box></geometry><material><diffuse>0.05 0.40 0.90 1</diffuse></material></visual>
    </link>
    <link name="front_left_steering_link"><pose>0.36 0.13 0.05 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial></link>
    <link name="front_right_steering_link"><pose>0.36 -0.13 0.05 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial></link>
    <joint name="front_left_steering_joint" type="revolute"><parent>base_link</parent><child>front_left_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>20</effort><velocity>4</velocity></limit></axis></joint>
    <joint name="front_right_steering_joint" type="revolute"><parent>base_link</parent><child>front_right_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>20</effort><velocity>4</velocity></limit></axis></joint>

    <link name="front_left_wheel"><pose>0.36 0.13 0.05 0 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00012</ixx><iyy>0.00006</iyy><izz>0.00012</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry></visual></link>
    <link name="front_right_wheel"><pose>0.36 -0.13 0.05 0 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00012</ixx><iyy>0.00006</iyy><izz>0.00012</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry></visual></link>
    <link name="rear_left_wheel"><pose>0 0.13 0.05 0 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00012</ixx><iyy>0.00006</iyy><izz>0.00012</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry></visual></link>
    <link name="rear_right_wheel"><pose>0 -0.13 0.05 0 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.00012</ixx><iyy>0.00006</iyy><izz>0.00012</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry></visual></link>
    <joint name="front_left_wheel_joint" type="revolute"><parent>front_left_steering_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><parent>front_right_steering_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit></axis></joint>
    <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>100</velocity></limit></axis></joint>
    <plugin filename="ignition-gazebo-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint><right_joint>front_right_wheel_joint</right_joint><left_joint>rear_left_wheel_joint</left_joint><right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint><right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.26</kingpin_width><wheel_base>0.36</wheel_base><wheel_separation>0.26</wheel_separation><wheel_radius>0.05</wheel_radius>
      <steering_limit>0.4</steering_limit><min_velocity>-1.5</min_velocity><max_velocity>1.5</max_velocity><min_acceleration>-0.5</min_acceleration><max_acceleration>0.5</max_acceleration><odom_topic>/model/aims_racer/wheel_odometry</odom_topic><odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_publish_frequency>50</odom_publish_frequency><odom_frame>odom</odom_frame><robot_base_frame>base_link</robot_base_frame><dimensions>2</dimensions></plugin>
  </model>
</sdf>
