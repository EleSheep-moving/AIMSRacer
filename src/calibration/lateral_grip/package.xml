<?xml version="1.0"?>
<package format="3">
  <name>aims_lateral_grip</name><version>0.1.0</version>
  <description>Explicit-session fixed nominal-steering lateral grip calibration and offline G-G evidence.</description>
  <maintainer email="maintainer@aimsracer.local">AIMSRacer</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rcl_interfaces</depend><depend>std_msgs</depend><depend>std_srvs</depend><depend>nav_msgs</depend><depend>geometry_msgs</depend><depend>sensor_msgs</depend><depend>diagnostic_msgs</depend><depend>vesc_msgs</depend><depend>crsf_receiver_msg</depend>
  <build_depend>libssl-dev</build_depend><build_depend>nlohmann-json-dev</build_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend><exec_depend>python3-matplotlib</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend><test_depend>rclpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
