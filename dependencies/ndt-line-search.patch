 #include <gtest/gtest.h>
+#include <cmath>
 
 #include <pcl/point_types.h>
 #include <pclomp/gicp_omp.h>
 #include <pclomp/ndt_omp.h>
+#include <pclomp/ndt_omp_impl.hpp>
 
 TEST(PublicApi, ConstructsExportedPointXyzRegistrations)
 {
@@ -17,3 +19,26 @@ TEST(PublicApi, ConstructsExportedPointXyzRegistrations)
   EXPECT_DOUBLE_EQ(ndt.getResolution(), 1.0);
   EXPECT_EQ(gicp.getMaximumIterations(), 5);
 }
+
+// Clamping a line-search trial can make it equal to an interval endpoint.
+// Interpolation must not divide by the resulting zero interval width.
+class NdtTrialSelection : public pclomp::NormalDistributionsTransform<pcl::PointXYZ, pcl::PointXYZ>
+{
+public:
+  using pclomp::NormalDistributionsTransform<pcl::PointXYZ, pcl::PointXYZ>::trialValueSelectionMT;
+};
+
+TEST(NdtLineSearch, CoincidentEndpointsReturnTheCurrentTrial)
+{
+  NdtTrialSelection ndt;
+  const double trial = ndt.trialValueSelectionMT(.005, -1., -1., .005, -1., -1., .005, -.999, -1.);
+  EXPECT_TRUE(std::isfinite(trial));
+  EXPECT_DOUBLE_EQ(trial, .005);
+}
+
+TEST(NdtLineSearch, TrialAtLowerEndpointRemainsFinite)
+{
+  NdtTrialSelection ndt;
+  const double trial = ndt.trialValueSelectionMT(.005, -1., -1., 0., 0., -1., .005, -.999, -1.);
+  EXPECT_TRUE(std::isfinite(trial));
+}
