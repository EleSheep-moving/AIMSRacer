diff --git a/src/component_trusted_anchor.cpp b/src/component_trusted_anchor.cpp
new file mode 100644
index 0000000..dfc97a5
--- /dev/null
+++ b/src/component_trusted_anchor.cpp
@@ -0,0 +1,179 @@
+#include "component_internal.hpp"
+#include <chrono>
+#include <iomanip>
+#include <sstream>
+namespace {
+std::int64_t anchorStampNs(const builtin_interfaces::msg::Time & stamp) {
+  return static_cast<std::int64_t>(stamp.sec)*1000000000LL+stamp.nanosec;
+}
+std::string preciseNumber(double value) {
+  std::ostringstream stream; stream << std::setprecision(17) << value; return stream.str();
+}
+}
+void PCLLocalization::resetTrustedAnchor(
+  const builtin_interfaces::msg::Time & stamp, const std::string & reason)
+{
+  callback_state_coordinator_.advanceInitialPoseGeneration();
+  trusted_anchor_state_={}; trusted_anchor_sequence_=0; trusted_event_sequence_=0;
+  trusted_initial_odom_ready_=false;
+  has_last_good_map_to_odom_=false; has_odom_tf_constraint_anchor_pose_=false;
+  initialpose_recieved_=false;
+  odom_bridge_transform_history_.clear();
+  has_last_odom_bridge_source_advance_node_stamp_=false;
+  publishTrustedAnchorStatus(stamp,false,reason);
+}
+void PCLLocalization::acceptTrustedInitialPose(
+  const geometry_msgs::msg::PoseWithCovarianceStamped::SharedPtr & msg)
+{
+  auto initial=std::make_shared<geometry_msgs::msg::PoseWithCovarianceStamped>(*msg);
+  auto & q=initial->pose.pose.orientation;
+  const double norm=std::sqrt(q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w);
+  if (!std::isfinite(norm) || norm<1e-8) {return;}
+  q.x/=norm; q.y/=norm; q.z/=norm; q.w/=norm;
+  auto generation_commit_lock=callback_state_coordinator_.lockGenerationCommit();
+  trusted_clock_reset_pending_.store(false,std::memory_order_release);
+  resetTrustedAnchor(msg->header.stamp,"initial_pose_reset");
+  initialpose_recieved_=true;
+  last_initial_pose_stamp_sec_=stamp_to_sec(msg->header.stamp);
+  corrent_pose_with_cov_stamped_ptr_=initial;
+  resetPredictionState(currentPoseMatrix(),last_initial_pose_stamp_sec_);
+  // A user seed is private. It cannot authorize navigation or publish map->odom.
+}
+void PCLLocalization::publishTrustedAnchorStatus(
+  const builtin_interfaces::msg::Time & stamp, bool committed,
+  const std::string & reason, const lidar_localization::AlignmentAttempt * attempt)
+{
+  if (!enable_trusted_anchor_protocol_ || !anchor_status_pub_ || !anchor_status_pub_->is_activated()) {return;}
+  diagnostic_msgs::msg::DiagnosticArray array; array.header.stamp=stamp;
+  array.header.frame_id=global_frame_id_;
+  diagnostic_msgs::msg::DiagnosticStatus status;
+  status.name="lidar_localization/anchor";
+  status.level=committed ? diagnostic_msgs::msg::DiagnosticStatus::OK : diagnostic_msgs::msg::DiagnosticStatus::WARN;
+  status.message=reason;
+  auto add=[&](const std::string & key,const std::string & value) {
+    diagnostic_msgs::msg::KeyValue entry; entry.key=key;entry.value=value;status.values.push_back(entry);
+  };
+  add("protocol_version","1");
+  add("epoch",trusted_anchor_process_id_+":"+std::to_string(callback_state_coordinator_.initialPoseGeneration()));
+  add("event_sequence",std::to_string(++trusted_event_sequence_));
+  add("anchor_sequence",std::to_string(trusted_anchor_sequence_));
+  add("anchor_committed",committed ? "true" : "false");
+  add("ready",trusted_anchor_state_.tracking && has_last_good_map_to_odom_ ? "true" : "false");
+  add("reason",reason);
+  add("last_anchor_stamp_ns",has_last_good_map_to_odom_ ? std::to_string(anchorStampNs(last_good_map_to_odom_.header.stamp)) : "0");
+  if (has_last_good_map_to_odom_) {
+    const auto & t=last_good_map_to_odom_.transform;
+    add("map_odom_x",preciseNumber(t.translation.x)); add("map_odom_y",preciseNumber(t.translation.y));
+    add("map_odom_z",preciseNumber(t.translation.z)); add("map_odom_qx",preciseNumber(t.rotation.x));
+    add("map_odom_qy",preciseNumber(t.rotation.y)); add("map_odom_qz",preciseNumber(t.rotation.z));
+    add("map_odom_qw",preciseNumber(t.rotation.w));
+  }
+  if (attempt) {
+    add("has_converged",attempt->has_converged ? "true" : "false");
+    add("fitness_score",preciseNumber(attempt->fitness_score));
+    add("correction_translation_m",preciseNumber(attempt->correction_translation_m));
+    add("correction_yaw_deg",preciseNumber(attempt->correction_yaw_deg));
+    add("correction_rotation_deg",preciseNumber(lidar_localization::rotationDeltaDeg(attempt->init_guess,attempt->final_transformation)));
+    add("alignment_time_sec",preciseNumber(attempt->alignment_time_sec));
+  }
+  array.status.push_back(status); anchor_status_pub_->publish(array);
+}
+void PCLLocalization::trustedCloudReceived(
+  const sensor_msgs::msg::PointCloud2::ConstSharedPtr & msg,
+  lidar_localization::CallbackStateCoordinator::StateLock & state_lock)
+{
+  if (!anchor_status_pub_ || !anchor_status_pub_->is_activated()) {return;}
+  if (trusted_clock_reset_pending_.exchange(false,std::memory_order_acq_rel)) {
+    resetTrustedAnchor(now(),"clock_rewind"); return;
+  }
+  if (!msg || !map_recieved_ || !initialpose_recieved_) {return;}
+  const double scan_sec=stamp_to_sec(msg->header.stamp);
+  const std::int64_t scan_ns=anchorStampNs(msg->header.stamp);
+  if (scan_ns<trusted_anchor_state_.last_scan_ns) {
+    resetTrustedAnchor(msg->header.stamp,"time_rewind"); return;
+  }
+  if (scan_ns==trusted_anchor_state_.last_scan_ns) {return;}
+  auto reject=[&](const std::string & reason) {
+    if (!trusted_anchor_state_.tracking) {trusted_anchor_state_.confirmations=0;}
+    publishTrustedAnchorStatus(msg->header.stamp,false,reason);
+  };
+  const double age=now().seconds()-scan_sec;
+  if (!std::isfinite(age) || age<0 || age>trusted_anchor_params_.max_age_sec) {reject("stale_scan");return;}
+  if (scan_sec<last_initial_pose_stamp_sec_-.01) {reject("scan_before_initialpose");return;}
+  geometry_msgs::msg::TransformStamped odom;
+  try {
+    odom=tfbuffer_.lookupTransform(odom_frame_id_,base_frame_id_,msg->header.stamp,rclcpp::Duration::from_seconds(0.0));
+    if (!trusted_anchor_state_.tracking && !trusted_initial_odom_ready_) {
+      const auto initial_odom=tfbuffer_.lookupTransform(odom_frame_id_,base_frame_id_,
+        corrent_pose_with_cov_stamped_ptr_->header.stamp,rclcpp::Duration::from_seconds(0.0));
+      trusted_initial_map_to_odom_=currentPoseMatrix()*
+        tf2::transformToEigen(initial_odom.transform).matrix().cast<float>().inverse();
+      trusted_initial_odom_ready_=true;
+    }
+  } catch (const tf2::TransformException &) {reject("odom_tf_unavailable");return;}
+  const Eigen::Matrix4f odom_matrix=tf2::transformToEigen(odom.transform).matrix().cast<float>();
+  const Eigen::Matrix4f map_odom=trusted_anchor_state_.tracking ?
+    tf2::transformToEigen(last_good_map_to_odom_.transform).matrix().cast<float>() : trusted_initial_map_to_odom_;
+  const Eigen::Matrix4f seed=map_odom*odom_matrix;
+  const auto processing_started=std::chrono::steady_clock::now();
+  const auto prepared=prepareScanForRegistration(msg,scan_sec);
+  if (!lidar_localization::isPreparedScanReady(prepared.status)) {reject("scan_preparation_failed");return;}
+  setRegistrationSourceCloud(prepared.cloud);
+  const auto generation=callback_state_coordinator_.initialPoseGeneration();
+  const auto attempt=runAlignmentAttempt(seed,seed,scan_sec,state_lock,generation);
+  if (shutting_down_.load(std::memory_order_acquire) ||
+      !callback_state_coordinator_.initialPoseGenerationMatches(generation)) {return;}
+  // This timing diagnostic never advances anchor/event sequence or readiness.
+  diagnostic_msgs::msg::DiagnosticArray timing_array;
+  timing_array.header=msg->header;
+  diagnostic_msgs::msg::DiagnosticStatus timing_status;
+  timing_status.name="lidar_localization/timing";
+  timing_status.message="scan preparation, map crop, alignment and fitness";
+  auto timing_value=[&](const std::string & key,const std::string & value) {
+    diagnostic_msgs::msg::KeyValue item;item.key=key;item.value=value;
+    timing_status.values.push_back(item);
+  };
+  timing_value("epoch",trusted_anchor_process_id_+":"+std::to_string(generation));
+  timing_value("scan_processing_time_sec",preciseNumber(std::chrono::duration<double>(
+    std::chrono::steady_clock::now()-processing_started).count()));
+  timing_value("alignment_time_sec",preciseNumber(attempt.alignment_time_sec));
+  timing_array.status.push_back(timing_status);
+  anchor_status_pub_->publish(timing_array);
+  const Eigen::Matrix4f candidate=attempt.final_transformation*odom_matrix.inverse();
+  lidar_localization::TrustedAnchorInput input;
+  input.scan_ns=scan_ns; input.age_sec=now().seconds()-scan_sec;
+  input.converged=attempt.target_ready && attempt.has_converged;
+  input.finite_pose=attempt.final_transformation.allFinite() && candidate.allFinite();
+  input.fitness=attempt.fitness_score;
+  input.correction_translation_m=attempt.correction_translation_m;
+  input.correction_rotation_deg=lidar_localization::rotationDeltaDeg(seed,attempt.final_transformation);
+  if (!trusted_anchor_state_.tracking && trusted_anchor_state_.confirmations>0) {
+    input.candidate_translation_delta_m=(candidate.block<3,1>(0,3)-trusted_candidate_map_to_odom_.block<3,1>(0,3)).norm();
+    input.candidate_rotation_delta_deg=lidar_localization::rotationDeltaDeg(trusted_candidate_map_to_odom_,candidate);
+  }
+  // Never query ROS time while holding this lock: jump callbacks may be
+  // waiting here while the clock's internal mutex is held. Epoch advancement
+  // and the final commit serialize, including the authoritative event.
+  auto generation_commit_lock=callback_state_coordinator_.lockGenerationCommit();
+  if (!callback_state_coordinator_.initialPoseGenerationMatches(generation)) {return;}
+  const auto decision=lidar_localization::decideTrustedAnchor(trusted_anchor_params_,trusted_anchor_state_,input);
+  if (!trusted_anchor_state_.tracking && trusted_anchor_state_.confirmations>0) {trusted_candidate_map_to_odom_=candidate;}
+  if (decision.invalidate) {resetTrustedAnchor(msg->header.stamp,decision.reason);return;}
+  if (!decision.commit) {publishTrustedAnchorStatus(msg->header.stamp,false,decision.reason,&attempt);return;}
+  // All failure checks precede the commit. Shared state, prediction and public
+  // anchor change together under the state lock, after the same final decision.
+  setCurrentPoseFromMatrix(attempt.final_transformation,msg->header.stamp);
+  fillPoseCovariance(attempt.fitness_score);
+  updatePredictionState(attempt.final_transformation,scan_sec);
+  const auto map_base=lidar_localization::makeMapToBaseTransform(msg->header.stamp,
+    global_frame_id_,base_frame_id_,corrent_pose_with_cov_stamped_ptr_->pose.pose);
+  last_good_map_to_odom_=lidar_localization::composeMapToOdomTransform(msg->header.stamp,
+    global_frame_id_,odom_frame_id_,map_base,odom,false);
+  has_last_good_map_to_odom_=true;
+  odom_tf_constraint_anchor_pose_matrix_=attempt.final_transformation;
+  has_odom_tf_constraint_anchor_pose_=true;
+  ++trusted_anchor_sequence_;
+  broadcaster_.sendTransform(last_good_map_to_odom_);
+  publishPoseMessage(*corrent_pose_with_cov_stamped_ptr_);
+  publishTrustedAnchorStatus(msg->header.stamp,true,decision.reason,&attempt);
+}
diff --git a/test/test_trusted_anchor_generation.cpp b/test/test_trusted_anchor_generation.cpp
new file mode 100644
index 0000000..4cebdc5
--- /dev/null
+++ b/test/test_trusted_anchor_generation.cpp
@@ -0,0 +1,16 @@
+#include "lidar_localization/callback_state_coordinator.hpp"
+#include <cassert>
+#include <future>
+#include <chrono>
+int main() {
+  lidar_localization::CallbackStateCoordinator coordinator;
+  auto commit=coordinator.lockGenerationCommit();
+  auto generation=coordinator.initialPoseGeneration();
+  std::promise<void> entered;
+  auto reset=std::async(std::launch::async,[&] {entered.set_value();coordinator.advanceInitialPoseGeneration();});
+  entered.get_future().wait();
+  assert(reset.wait_for(std::chrono::milliseconds(20))==std::future_status::timeout);
+  assert(coordinator.initialPoseGenerationMatches(generation));
+  commit.unlock();reset.get();
+  assert(!coordinator.initialPoseGenerationMatches(generation));
+}
diff --git a/test/test_trusted_anchor_policy.cpp b/test/test_trusted_anchor_policy.cpp
new file mode 100644
index 0000000..bac40fc
--- /dev/null
+++ b/test/test_trusted_anchor_policy.cpp
@@ -0,0 +1,40 @@
+#include "lidar_localization/trusted_anchor_policy.hpp"
+#include <cassert>
+#include <cmath>
+using namespace lidar_localization;
+int main() {
+  TrustedAnchorParams p;
+  TrustedAnchorState state;
+  TrustedAnchorInput in;
+  in.scan_ns = 1000000000; in.age_sec=.05; in.converged=true;
+  in.finite_pose=true; in.fitness=.2; in.correction_rotation_deg=11.32;
+  assert(decideTrustedAnchor(p,state,in).reason=="initializing");
+  in.scan_ns+=100000000;
+  assert(!decideTrustedAnchor(p,state,in).commit);
+  in.scan_ns+=100000000;
+  assert(decideTrustedAnchor(p,state,in).commit);
+  assert(state.tracking);
+  in.scan_ns+=100000000;
+  assert(decideTrustedAnchor(p,state,in).reason=="correction_rotation");
+  assert(state.tracking); // rejection never destroys or replaces the trusted anchor
+  in.correction_rotation_deg=1.; in.correction_translation_m=.6; in.scan_ns+=100000000;
+  assert(decideTrustedAnchor(p,state,in).reason=="correction_translation");
+  in.correction_translation_m=.1; in.age_sec=.51; in.scan_ns+=100000000;
+  assert(decideTrustedAnchor(p,state,in).reason=="stale_scan");
+  in.age_sec=.05; in.fitness=std::nan(""); in.scan_ns+=100000000;
+  assert(decideTrustedAnchor(p,state,in).reason=="invalid_result");
+  in.fitness=.2; in.scan_ns+=100000000;
+  assert(decideTrustedAnchor(p,state,in).commit);
+  assert(decideTrustedAnchor(p,state,in).reason=="duplicate_scan");
+  in.scan_ns-=100000000;
+  assert(decideTrustedAnchor(p,state,in).invalidate);
+  assert(!state.tracking);
+  state={}; in.scan_ns=2000000000; in.candidate_translation_delta_m=0;
+  assert(!decideTrustedAnchor(p,state,in).commit);
+  in.scan_ns+=100000000; in.candidate_translation_delta_m=1.;
+  assert(decideTrustedAnchor(p,state,in).reason=="initial_candidate_inconsistent");
+  assert(state.confirmations==1);
+  in.scan_ns+=100000000; in.candidate_translation_delta_m=0.;
+  assert(!decideTrustedAnchor(p,state,in).commit);
+  in.scan_ns+=100000000; assert(decideTrustedAnchor(p,state,in).commit);
+}
