diff --git a/include/lidar_localization/trusted_anchor_policy.hpp b/include/lidar_localization/trusted_anchor_policy.hpp
new file mode 100644
index 0000000..38db8e6
--- /dev/null
+++ b/include/lidar_localization/trusted_anchor_policy.hpp
@@ -0,0 +1,63 @@
+#ifndef LIDAR_LOCALIZATION_TRUSTED_ANCHOR_POLICY_HPP_
+#define LIDAR_LOCALIZATION_TRUSTED_ANCHOR_POLICY_HPP_
+#include <cmath>
+#include <cstdint>
+#include <string>
+namespace lidar_localization {
+struct TrustedAnchorParams {
+  double max_fitness{1.5}, max_translation_m{0.5}, max_rotation_deg{10.0}, max_age_sec{0.5};
+  int initial_confirmations{3};
+};
+struct TrustedAnchorState {
+  std::int64_t last_scan_ns{-1};
+  bool tracking{false};
+  int confirmations{0};
+};
+struct TrustedAnchorInput {
+  std::int64_t scan_ns{0};
+  double age_sec{0}, fitness{0}, correction_translation_m{0}, correction_rotation_deg{0};
+  double candidate_translation_delta_m{0}, candidate_rotation_delta_deg{0};
+  bool converged{false}, finite_pose{false};
+};
+struct TrustedAnchorDecision { bool commit{false}, invalidate{false}; std::string reason; };
+inline bool validTrustedAnchorParams(const TrustedAnchorParams & p) {
+  return std::isfinite(p.max_fitness) && p.max_fitness>=0 &&
+    std::isfinite(p.max_translation_m) && p.max_translation_m>0 &&
+    std::isfinite(p.max_rotation_deg) && p.max_rotation_deg>0 &&
+    std::isfinite(p.max_age_sec) && p.max_age_sec>0 && p.initial_confirmations>=3;
+}
+// Called only after source-time odom is available and reset-generation still matches.
+// Rejected measurements never change a committed anchor or prediction state.
+inline TrustedAnchorDecision decideTrustedAnchor(
+  const TrustedAnchorParams & p, TrustedAnchorState & s, const TrustedAnchorInput & in)
+{
+  if (!validTrustedAnchorParams(p)) {return {false,false,"invalid_parameters"};}
+  if (in.scan_ns<s.last_scan_ns) {s={}; return {false,true,"time_rewind"};}
+  if (in.scan_ns==s.last_scan_ns) {return {false,false,"duplicate_scan"};}
+  s.last_scan_ns=in.scan_ns;
+  auto reject=[&](const char * reason) {if (!s.tracking) {s.confirmations=0;} return TrustedAnchorDecision{false,false,reason};};
+  if (!std::isfinite(in.age_sec) || in.age_sec<0 || in.age_sec>p.max_age_sec) {return reject("stale_scan");}
+  if (!in.converged) {return reject("not_converged");}
+  if (!in.finite_pose || !std::isfinite(in.fitness) || in.fitness<0 ||
+      !std::isfinite(in.correction_translation_m) || in.correction_translation_m<0 ||
+      !std::isfinite(in.correction_rotation_deg) || in.correction_rotation_deg<0 ||
+      !std::isfinite(in.candidate_translation_delta_m) || !std::isfinite(in.candidate_rotation_delta_deg)) {
+    return reject("invalid_result");
+  }
+  if (in.fitness>p.max_fitness) {return reject("fitness");}
+  if (s.tracking) {
+    if (in.correction_translation_m>p.max_translation_m) {return reject("correction_translation");}
+    if (in.correction_rotation_deg>p.max_rotation_deg) {return reject("correction_rotation");}
+    return {true,false,"committed"};
+  }
+  const bool inconsistent=s.confirmations>0 &&
+    (in.candidate_translation_delta_m>p.max_translation_m || in.candidate_rotation_delta_deg>p.max_rotation_deg);
+  s.confirmations=inconsistent ? 1 : s.confirmations+1;
+  if (s.confirmations<p.initial_confirmations) {
+    return {false,false,inconsistent ? "initial_candidate_inconsistent" : "initializing"};
+  }
+  s.tracking=true;
+  return {true,false,"committed"};
+}
+} // namespace lidar_localization
+#endif
